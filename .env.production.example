# Template for the .env that lives ON THE EC2 INSTANCE.
# Copy to .env there, fill in the CHANGE_ME values, and never commit the result.
#
# docker-compose.prod.yml passes this file into api_gateway verbatim and
# overrides nothing, so every value below is exactly what the app will see.
# Change anything here and restart to apply - no rebuild needed:
#     docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# NOTE: api_gateway reads this whole file. face_service does not - it gets no
# secrets at all, by design.

APP_NAME=Visitor Management System
COMPANY_NAME=404
ENV=production

# ---------------------------------------------------------------------------
# DATABASE - Postgres running as the "db" container on this same instance.
#
# The host is "db" - the container name on the internal Docker network, NOT
# localhost. Inside the api_gateway container "localhost" means api_gateway
# itself, so a dev value copied over unchanged fails every query.
#
# !! THE PASSWORD APPEARS TWICE and the two MUST match !!
# DATABASE_URL is what the app connects with; POSTGRES_PASSWORD is what the
# database is created with. If they drift you get "password authentication
# failed for user" on startup and nothing else works. Change one, change both.
#
# Generate a password with:  openssl rand -base64 24 | tr -d '/+='
# Keep it alphanumeric - any @ : / ? # in a password must be percent-encoded
# inside DATABASE_URL or SQLAlchemy misparses the host, and the tr above avoids
# that problem entirely.
# ---------------------------------------------------------------------------
POSTGRES_USER=vms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=vms
DATABASE_URL=postgresql://vms:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/vms

# ---------------------------------------------------------------------------
# Auth. Generate a fresh secret - do not reuse the dev one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every issued token, which is what you want on the
# move to production.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_RUN_THE_COMMAND_ABOVE
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# FACE SERVICE - the container name on the internal Docker network.
# Same rule as the database: "face_service", never localhost. The port stays
# internal and is never published to the host.
# ---------------------------------------------------------------------------
FACE_SERVICE_URL=http://face_service:8001
FACE_MATCH_THRESHOLD=0.70

# ---------------------------------------------------------------------------
# PUBLIC URLs. Fill in AFTER the frontends are deployed - these go into QR codes
# and SMS/email links, so a wrong value produces dead links that look like an
# app bug.
#
#   PUBLIC_BASE_URL  -> the VISITOR app's origin (/register/:token, /pass/:token
#                       and /walkin/:token are routes in that SPA)
#   FRONTEND_ORIGIN  -> the STAFF frontend's origin
#   CORS_ORIGINS     -> comma-separated, must list BOTH of the above exactly,
#                       with scheme and no trailing slash
#
# If CORS_ORIGINS is missing the app falls back to localhost-only defaults and
# both deployed frontends get blocked by the browser - with a console error that
# does not obviously point at this file. Do not omit it.
#
# Both must be https:// - the visitor app's camera capture needs a secure
# context, and an https page cannot call an http API.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://CHANGE_ME_visitor_app_host
FRONTEND_ORIGIN=https://CHANGE_ME_staff_frontend_host
CORS_ORIGINS=https://CHANGE_ME_staff_frontend_host,https://CHANGE_ME_visitor_app_host

# ---------------------------------------------------------------------------
# Outbound email / SMS. Leave any of these empty and that client logs the
# message instead of sending it, which keeps the whole flow testable.
# ROTATE these before real traffic - the dev values have been sitting in a
# plaintext .env on a laptop.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@vms.local
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------------------
# Infrastructure. All optional - docker-compose.prod.yml defaults them.
#   API_HOST_PORT   host port for api_gateway (the CloudFront origin port)
#   OMP_NUM_THREADS onnxruntime threads; raise only if you resize the instance
#   POSTGRES_IMAGE  pin a different Postgres version if you ever need to
# ---------------------------------------------------------------------------
API_HOST_PORT=80
OMP_NUM_THREADS=1
POSTGRES_IMAGE=postgres:16-alpine
